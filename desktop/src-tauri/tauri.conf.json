{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Kato",
  "version": "0.1.0",
  "identifier": "dev.kato.desktop",
  "build": {
    "frontendDist": "./loading"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Kato",
        "hiddenTitle": true,
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/kato-sidecar"],
    "resources": [],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://REPLACE-WITH-YOUR-RELEASE-HOST/desktop/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "REPLACE_WITH_YOUR_TAURI_SIGNER_PUBLIC_KEY"
    }
  }
}
