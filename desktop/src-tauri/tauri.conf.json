{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Kato",
  "version": "0.1.0",
  "identifier": "dev.kato.desktop",
  "build": {
    "frontendDist": "./loading"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Kato",
        "hiddenTitle": true,
        "backgroundColor": "#0f1115",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/kato-sidecar"],
    "resources": [],
    "createUpdaterArtifacts": true,
    "macOS": {
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/shay-te/kato/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFEMjU4Q0VERDBGNjU4ODgKUldTSVdQYlE3WXdsSGRac3ZxcVF6U1NVRGJtMTNRc3hPMzFxWVk4NDBwbnczM3ptN0szTENlcFMK"
    }
  }
}
